# ---------------------------------------------------------------------------
# Bends Social Manager — environment configuration
#
# Copy to .env and fill in. Never commit .env.
#
# Important: OAuth access tokens are NOT stored here. They are encrypted with
# ENCRYPTION_MASTER_KEY and stored in Postgres. This file only holds the app
# credentials that identify our application to each platform.
# ---------------------------------------------------------------------------

# --- Core infrastructure ---------------------------------------------------
DATABASE_URL="postgresql://bends:bends@localhost:5432/bends_social?schema=public"
REDIS_URL="redis://localhost:6379"

# Public base URL of this app. Must be HTTPS and publicly reachable, because
# both Meta and TikTok redirect the browser back here after login.
# For local development use a tunnel (see docs/SETUP.md).
APP_URL="https://localhost:3000"

# --- Encryption ------------------------------------------------------------
# 32 bytes, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this belongs in the host's secret manager, not in a file.
ENCRYPTION_MASTER_KEY=""
ENCRYPTION_KEY_ID="v1"

# Signs login session cookies. Generate the same way as above.
SESSION_SECRET=""

# --- Meta (Instagram + Facebook) ------------------------------------------
# From https://developers.facebook.com/apps -> your app -> App Settings -> Basic
META_APP_ID=""
META_APP_SECRET=""
# Pin the Graph API version explicitly. Meta deprecates versions on a schedule;
# an unpinned call can change behaviour without any change on our side.
META_GRAPH_VERSION="v23.0"
# Optional. Overrides which permissions are requested at login.
#
# Meta gates permissions behind per-app "use case" configuration. If the app has
# not enabled one, the whole login fails with "Invalid Scopes" naming the
# offending permissions — it does not simply skip them. Narrow this list to what
# the app currently has enabled to get connected, then widen it as you switch
# the rest on in the App Dashboard under Use cases.
#
# Minimum to connect and read:
#   META_SCOPES="instagram_basic,pages_show_list,pages_read_engagement"
# Add business_management if your Page belongs to a Business Portfolio and your
# profile has no direct role on it — it lets the app find the Page through the
# business. Not requested by default, since most setups do not need it.
# Full set needed to publish and read insights:
#   META_SCOPES="instagram_basic,instagram_content_publish,instagram_manage_insights,pages_show_list,pages_read_engagement,pages_manage_posts"
META_SCOPES=""

# --- TikTok ----------------------------------------------------------------
# From https://developers.tiktok.com/apps -> your app -> Basic information
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- Media storage (S3-compatible; Cloudflare R2 recommended) --------------
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="bends-social-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public read URL for the bucket. Meta and TikTok fetch media from this host,
# so it must be reachable without authentication.
S3_PUBLIC_BASE_URL="https://media.example.com"

# --- Behaviour -------------------------------------------------------------
# The audience timezone. All scheduling and all "best hour to post" analysis is
# expressed in this zone.
AUDIENCE_TIMEZONE="Asia/Jerusalem"

# Master safety switch. While true, nothing publishes without an explicit
# human approval recorded against the post.
REQUIRE_MANUAL_APPROVAL="true"

# Set to true only after TikTok has approved the API client audit. Until then
# the adapter forces SELF_ONLY on every TikTok post regardless of this value.
TIKTOK_CLIENT_AUDITED="false"
